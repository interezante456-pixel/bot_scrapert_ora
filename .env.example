# ======================================
# BES Scraper Engine — Variables de Entorno
# ======================================

# -------------------------------------------------------------------
# BROWSER
# -------------------------------------------------------------------
# Modo del navegador.
# false = navegador VISIBLE en pantalla (por defecto — útil para depuración)
# true  = navegador OCULTO / headless (para producción o ejecución automática)
HEADLESS=false

# Ruta al ejecutable de Chrome/Chromium.
# Dejar vacío para usar el Chromium bundled de Puppeteer.
# Ejemplo Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
# Ejemplo Linux:   /usr/bin/google-chrome
PUPPETEER_EXECUTABLE_PATH=

# -------------------------------------------------------------------
# OUTPUT
# -------------------------------------------------------------------
# Directorio donde se guardarán los PDFs descargados de SUNAT
# y los JSONs de resultados de SUNAFIL.
OUTPUT_DIR=./output

# -------------------------------------------------------------------
# HTTP SERVER (opcional)
# -------------------------------------------------------------------
# Puerto del servidor HTTP interno para integración con el backend.
HTTP_PORT=3001

# -------------------------------------------------------------------
# CREDENCIALES (alternativa a pasar por CLI)
# Se pueden sobreescribir con flags --ruc, --usuario, --clave en CLI.
# -------------------------------------------------------------------
# SUNAT_RUC=20123456789
# SUNAT_USUARIO=MOLLO
# SUNAT_CLAVE=tu_clave_aqui

# SUNAFIL_RUC=20123456789
# SUNAFIL_USUARIO=MOLLO
# SUNAFIL_CLAVE=tu_clave_aqui
